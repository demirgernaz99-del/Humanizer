# --- App ---
APP_NAME=SignalBot
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
DEV_MODE=1                       # 1 = Dev-Upgrade-Button statt Stripe (zum lokalen Testen)

# --- Datenbank ---
DATABASE_URL=sqlite:///./signalbot.db

# --- Markt-Scanner ---
BINANCE_BASE_URL=https://api.binance.com
PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
TIMEFRAME=1h
SCAN_INTERVAL=300                # Sekunden zwischen Scans

# --- Tarif-Gating ---
FREE_PAIRS=BTCUSDT,ETHUSDT       # Paare, die Free-Nutzer sehen
FREE_DELAY_MIN=60                # Signal-Verzoegerung fuer Free-Nutzer (Minuten)

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=         # Price-ID aus dem Stripe-Dashboard (recurring)
STRIPE_PRICE_ID_YEARLY=
PRICE_MONTHLY_DISPLAY=19,99 €
PRICE_YEARLY_DISPLAY=199 €
